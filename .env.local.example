# Firebase client config (from Firebase console > Project settings > General)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (from Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the JSON. Keep the quotes and \n escapes as-is.
FIREBASE_PRIVATE_KEY=""

# ── Optional (Phase 1–3). Leave unset to keep each feature off. ──
# Nightly check of the daily sales summaries (Vercel cron): any long random string
# CRON_SECRET=
# Sentry error reports (server / browser) — same DSN in both
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Firebase App Check: reCAPTCHA Enterprise site key; APP_CHECK = off | monitor | enforce
# NEXT_PUBLIC_APPCHECK_SITE_KEY=
# APP_CHECK=off
# Two-step login required for admin / manager / accountant (set both to 1)
# NEXT_PUBLIC_REQUIRE_2FA=
# REQUIRE_2FA=
# Company settings (lib/companyConfig.js) — defaults are Mahgoub Sons'. Don't change the
# time zone on a live system (daily summaries, logs and invoice-number years depend on it).
# NEXT_PUBLIC_COMPANY_NAME=محجوب أولاد الغذائية
# NEXT_PUBLIC_COMPANY_NAME_EN=Mahgoub Sons Food
# NEXT_PUBLIC_CURRENCY=SDG
# NEXT_PUBLIC_TIME_ZONE=Africa/Khartoum
# NEXT_PUBLIC_UTC_OFFSET=+02:00
