rules_version = '2';

// Deny-all: no direct browser access to any data.
//
// Every read and write in this app goes through the server API routes,
// which use the Firebase Admin SDK. The Admin SDK bypasses these rules
// entirely, so the app keeps working exactly as before — this only shuts
// the side door.
//
// Why this matters: the Firebase web config is public by design, so any
// staff member with a login could otherwise skip the app and talk to
// Firestore directly — editing an invoice total without touching stock or
// edit history, writing unvalidated client records, or reading supplier
// prices. With deny-all, the API (with its role checks, validation, stock
// transactions, and field stripping) is the only way in.
//
// Real-time listeners follow that rule: ONLY meta/versions is readable,
// read-only (see below). Any future exception must be just as narrow —
// never broad write rules, never business data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // The single exception: live change counters for real-time refresh
    // (lib/liveVersions.js). Holds plain numbers only — "orders_car1: 42" —
    // no names, prices, or order data; the same values GET /api/versions
    // already returns to any signed-in staff member.
    //   - get only: no list (can't enumerate /meta, which also holds
    //     clientIdCounter), and never write — only the Admin SDK bumps these.
    //   - signed in AND holding a staff role claim, same bar as the API.
    match /meta/versions {
      allow get: if request.auth != null
        && request.auth.token.role in ['agent_car1', 'agent_car2', 'supervisor', 'warehouse_keeper', 'depot_viewer'];
    }
  }
}
