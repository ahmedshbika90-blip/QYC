rules_version = '2';

// Deny-all: no direct browser access to any data.
//
// Every read and write in this app goes through the server API routes,
// which use the Firebase Admin SDK. The Admin SDK bypasses these rules
// entirely, so the app keeps working exactly as before — this only shuts
// the side door.
//
// Why this matters: the Firebase web config is public by design, so any
// staff member with a login could otherwise skip the app and talk to
// Firestore directly — editing an invoice total without touching stock or
// edit history, writing unvalidated client records, or reading supplier
// prices. With deny-all, the API (with its role checks, validation, stock
// transactions, and field stripping) is the only way in.
//
// If a future feature ever needs direct browser access (e.g. real-time
// listeners), open ONLY that specific collection with a narrow read rule
// — never broad write rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
